# Optional future provider selection. Blank values keep it unconfigured.
# This file is documentation only; the application does not auto-load dotenv.
NORTHSTAR_LLM_PROVIDER=
NORTHSTAR_LLM_MODEL=

# Nebius adapter: explicit environment exports only; no automatic dotenv.
# No model default. Choose an account-available model and authorize live checks
# separately. Never place a real API key in this tracked example.
NEBIUS_API_KEY=
NEBIUS_MODEL=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
